# Dev Studio AI assist (local only, optional).
# Step-by-step guide: https://github.com/IntoTheDigital/hearsay-harbour#setting-up-ai-assist-step-by-step
#
# Copy this file to .env and fill it in (everything after the =, no spaces or quotation marks).
# .env stays on your computer: git ignores it and it's never published.
# Pictures you ask about are sent to the provider below (with ollama they never leave your computer).

# Which provider: openai, gemini, anthropic, or ollama (a model running on this computer).
HH_AI_PROVIDER=

# The model to use. It must accept images: copy a current name from your provider's model list.
# With anthropic you can leave this empty (it uses claude-opus-5-5).
HH_AI_MODEL=

# Your own key, on the line for the provider you chose (ollama needs none).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama only: where it's running.
HH_OLLAMA_URL=http://localhost:11434
