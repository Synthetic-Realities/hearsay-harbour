# Dev Studio AI assist (local only, optional).
# Copy this file to .env and fill it in. .env is ignored by git and never published.
# The Studio sends each picture you choose to suggest to the provider below.

# Which provider: openai, gemini, anthropic, or ollama (a model running on this computer).
HH_AI_PROVIDER=

# The model to use. It must accept images. Check your provider's current model list.
# Anthropic defaults to claude-opus-5-5 if this is left empty; the others need a value,
# e.g. a GPT vision model, a Gemini Flash or Pro model, or llama3.2-vision for Ollama.
HH_AI_MODEL=

# Your own key for the provider you chose (only that one is needed).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama only: where it's running (no key needed; pictures never leave this computer).
HH_OLLAMA_URL=http://localhost:11434
